# Copy this file to .streamlit/secrets.toml and fill in real values.
# .streamlit/secrets.toml is git-ignored — NEVER commit real credentials.
# On Streamlit Community Cloud, paste the same content into
# App settings -> Secrets instead of using this file.

[openai]
api_key = "sk-your-openai-api-key-here"
model = "gpt-4o-mini"

# ── Google Sign-In (OpenID Connect) ─────────────────────────────────────────
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console -> APIs & Services -> Credentials. Add an authorized redirect URI
# matching redirect_uri below (use your deployed URL in production, e.g.
# https://your-app.streamlit.app/oauth2callback).
# cookie_secret: any long random string, e.g. `openssl rand -hex 32`.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ── Admin allowlist ──────────────────────────────────────────────────────────
# Only these signed-in emails can open pages/4_Dashboard.py.
[admin]
emails = ["you@example.com"]

# ── Supabase (database + storage) ───────────────────────────────────────────
# Create a free project at https://supabase.com, run supabase/schema.sql in
# its SQL editor, then create a private "farm-reports" storage bucket
# (public = false). Use the SERVICE ROLE key here, never the anon key —
# see core/db_service.py for why.
[supabase]
url = "https://YOUR_PROJECT.supabase.co"
service_role_key = "your-service-role-key"

# ── Legacy Google Sheets logger (optional) ──────────────────────────────────
# Kept for backward compatibility. Supabase (above) is now the primary store.
[logger]
sheet_url = "https://script.google.com/macros/s/YOUR_ID/exec"
